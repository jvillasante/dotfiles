BasedOnStyle: LLVM

---
Language: Cpp

# --- General ---
ColumnLimit: 80
IndentWidth: 4
AccessModifierOffset: -4
MaxEmptyLinesToKeep: 1

# --- Pointers & Includes ---
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes: true
ReflowComments: false
FixNamespaceComments: true

# --- Constructors & Lists ---
Cpp11BracedListStyle: true
PackConstructorInitializers: NextLine
AlwaysBreakTemplateDeclarations: true

# --- Short Blocks (Preventing ugly one-liners) ---
AllowShortBlocksOnASingleLine: Never
AllowShortEnumsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortFunctionsOnASingleLine: InlineOnly # or 'Empty'

# --- Braces (The "Sane" Hybrid Style) ---
BreakBeforeBraces: Custom
BraceWrapping:
  # Structural blocks get their own line for clarity
  AfterClass:            true
  AfterEnum:             true
  AfterFunction:         true
  AfterNamespace:        true
  AfterStruct:           true
  AfterUnion:            true
  AfterExternBlock:      true
  AfterObjCDeclaration:  true
  AfterCaseLabel:        true

  # Control flow stays attached to save vertical space
  AfterControlStatement: false
  BeforeCatch:           false
  BeforeElse:            false
  BeforeWhile:           false
  BeforeLambdaBody:      false

  IndentBraces:          false

  # Empty blocks collapse to {} to save space
  SplitEmptyFunction:    false
  SplitEmptyRecord:      false
  SplitEmptyNamespace:   false
---
