# -*- mode: sh; sh-shell: bash -*-

# Set the path to include:
#  - /usr/local/bin
#  - /usr/local/sbin
#  - /usr/bin
#  - /bin
#  - /usr/sbin
#  - /sbin
export PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"

# Ensure local bin is in path
if [[ ":$PATH:" != *":$XDG_BIN_HOME:"* ]]; then
    export PATH="$XDG_BIN_HOME:$PATH"
fi

# emacs vterm: https://github.com/akermu/emacs-libvterm
if [ "$INSIDE_EMACS" = 'vterm' ] && [ -n "$EMACS_VTERM_PATH" ]; then
    if [ "$(readlink /proc/$$/exe)" = "$(which bash)" ]; then
        # shellcheck source=/dev/null
        [ -f "$EMACS_VTERM_PATH/etc/emacs-vterm-bash.sh" ] &&
            source "$EMACS_VTERM_PATH/etc/emacs-vterm-bash.sh"
    elif [ "$(readlink /proc/$$/exe)" = "$(which zsh)" ]; then
        # shellcheck source=/dev/null
        [ -f "$EMACS_VTERM_PATH/etc/emacs-vterm-zsh.sh" ] &&
            source "$EMACS_VTERM_PATH/etc/emacs-vterm-zsh.sh"
    elif [ "$(readlink /proc/$$/exe)" = "$(which fish)" ]; then
        # shellcheck source=/dev/null
        [ -f "$EMACS_VTERM_PATH/etc/emacs-vterm-fish.sh" ] &&
            source "$EMACS_VTERM_PATH/etc/emacs-vterm-fish.sh"
    fi

    # Open a file in Emacs from the terminal
    e()   { vterm_cmd find-file "${1:-$PWD}"; }
    eow() { vterm_cmd find-file-other-window "${1:-$PWD}"; }

    # Open dired in another window, defaulting to the current directory
    d()   { vterm_cmd dired "${1:-$PWD}"; }
    dow() { vterm_cmd dired-other-window "${1:-$PWD}"; }
fi

# emacs ghostel: https://github.com/dakra/ghostel
if [[ "$INSIDE_EMACS" = 'ghostel' ]]; then
    # Open a file in Emacs from the terminal
    e() { ghostel_cmd find-file "$@"; }
    eow() { ghostel_cmd find-file-other-window "$@"; }

    # Open dired in another window, defaulting to the current directory
    d() { ghostel_cmd dired "${1:-$PWD}"; }
    dow() { ghostel_cmd dired-other-window "${1:-$PWD}"; }
fi

# emacs eat: https://codeberg.org/akib/emacs-eat
if [ -n "$EAT_SHELL_INTEGRATION_DIR" ]; then
    if [ -r "$EAT_SHELL_INTEGRATION_DIR/bash" ]; then
        # shellcheck source=/dev/null
        source "$EAT_SHELL_INTEGRATION_DIR/bash"
    fi

    # eat alias to open a file inside emacs
    alias eopen='_eat_msg open'
fi

# vcpkg
if [ -d "$HOME/Workspace/Software/vcpkg/" ]; then
    export VCPKG_ROOT="$HOME/Workspace/Software/vcpkg"
    export PATH="$PATH:$VCPKG_ROOT"
fi

# snap
[ -d "/snap/bin" ] && export PATH="$PATH:/snap/bin"

# common-lisp qlot
if [ -d "$XDG_DATA_HOME/qlot/bin/" ]; then
    export PATH="$PATH:$XDG_DATA_HOME/qlot/bin"
fi

# npm global prefix (user-owned, set via `npm config set prefix` in post_install)
if [ -d "$XDG_DATA_HOME/npm/bin" ]; then
    export PATH="$PATH:$XDG_DATA_HOME/npm/bin"
fi

# llvm
[ -d "/usr/local/opt/llvm/bin" ] && export PATH="/usr/local/opt/llvm/bin:$PATH"

# Rust
if [ -d "$HOME/.cargo/bin" ]; then
    export CARGO_HOME="$HOME/.cargo"
    if [ -f "$CARGO_HOME/env" ]; then
        # shellcheck source=/dev/null
        source "$CARGO_HOME/env"
    else
        export PATH="$CARGO_HOME/bin:$PATH"
    fi

    LD_LIBRARY_PATH="$(rustc --print sysroot)/lib:$LD_LIBRARY_PATH" && export LD_LIBRARY_PATH
    RUST_SRC_PATH="$(rustc --print sysroot)/lib/rustlib/src/rust/src" && export RUST_SRC_PATH
fi

# Go
if type go > /dev/null 2> /dev/null; then
    GOPATH="$XDG_DATA_HOME/go" && export GOPATH
    GOBIN="$GOPATH/bin" && export GOBIN
    [ ! -d "$GOBIN" ] && mkdir -p "$GOBIN"
    PATH="$GOBIN:$PATH" && export PATH
fi

# Guile
if type guile > /dev/null 2> /dev/null; then
    # Disable auto-compiling to .go files.
    # Great for scripting so you don't litter ~/.cache/guile/ccache with bytecode.
    export GUILE_AUTO_COMPILE=0

    # Silence deprecation warnings. If you run third-party scripts,
    # you rarely care about Guile's internal API deprecations.
    export GUILE_WARN_DEPRECATED=no

    # Where Guile should look for your own custom Scheme modules
    export GUILE_LOAD_PATH="$HOME/.local/share/guile/site/3.0:$GUILE_LOAD_PATH"

    # Where Guile should look for compiled bytecode modules (if you re-enable compilation)
    export GUILE_LOAD_COMPILED_PATH="$HOME/.local/lib/guile/3.0/site-ccache:$GUILE_LOAD_COMPILED_PATH"
fi
